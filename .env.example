# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 网站配置
SITE_TITLE=TechBlog - 个人技术博客
SITE_DESCRIPTION=分享前端开发、后端架构、编程心得
SITE_URL=https://github.com/Huanglh337/hlhdemo

# SEO 配置
SEO_KEYWORDS=JavaScript, CSS, HTML, 前端开发, 后端开发
OG_IMAGE_URL=https://via.placeholder.com/1200x630?text=TechBlog

# 联系方式
GITHUB_URL=https://github.com
CONTACT_EMAIL=your@email.com

# 主题配置
PRIMARY_COLOR=#2563eb
DARK_MODE=false
